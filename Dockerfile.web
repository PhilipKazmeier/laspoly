# ---- build stage ----
FROM node:22-slim AS build
WORKDIR /app

# Copy root manifests
COPY package.json package-lock.json ./

# Copy package manifests (needed before npm ci for workspace resolution)
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/client/package.json packages/client/

# Install all deps (including devDeps needed for build)
RUN npm ci

# Copy sources
COPY packages/ packages/
COPY tsconfig.base.json ./

# Build the client
RUN npm run build -w @laspoly/client

# ---- runtime stage ----
FROM node:22-slim AS runtime
WORKDIR /app

# Run as non-root user
RUN addgroup --system --gid 1001 laspoly && \
    adduser --system --uid 1001 --ingroup laspoly laspoly

# Copy root manifests and install prod deps + tsx (needed to run TS server)
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/client/package.json packages/client/

# Install only what's needed at runtime (including tsx from root devDeps)
RUN npm ci

# Copy server + shared sources
COPY packages/server/ packages/server/
COPY packages/shared/ packages/shared/

# Copy built client dist
COPY --from=build /app/packages/client/dist packages/client/dist

# Copy base tsconfig (tsx needs it for path resolution)
COPY tsconfig.base.json ./

# Set ownership
RUN chown -R laspoly:laspoly /app

USER laspoly

ENV NODE_ENV=production
# PORT: server listen port (default 8080)
ENV PORT=8080
# ALLOWED_ORIGINS: comma-separated list of allowed WebSocket origins.
# Leave unset (or empty) to allow all origins. Set in production, e.g.:
#   ALLOWED_ORIGINS=https://example.com,https://www.example.com
ENV ALLOWED_ORIGINS=

EXPOSE 8080

# Health check — container/orchestrator readiness probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Use --init (or tini) for correct PID-1 signal handling — pass via compose `init: true`
# or invoke directly: docker run --init ...
CMD ["npx", "tsx", "packages/server/src/index.ts"]
