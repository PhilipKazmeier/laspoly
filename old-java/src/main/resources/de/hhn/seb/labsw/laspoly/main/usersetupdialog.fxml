<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
           minWidth="-Infinity"
           prefHeight="129.0" prefWidth="358.0" xmlns="http://javafx.com/javafx/8">
    <AnchorPane id="dialogstack" prefHeight="125.0" prefWidth="358.0">
        <GridPane vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label id="userNameLabel" text="Lorem ipsum"/>
                <TextField id="userNameField" GridPane.columnIndex="1">
                    <font>
                    <Font size="12.0" />
                </font></TextField>
                <Label id="languageLabel" text="Lorem ipsum" GridPane.rowIndex="1"/>
                <HBox prefHeight="100.0" prefWidth="200.0" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <fx:define>
                            <ToggleGroup fx:id="toggleGroup"/>
                        </fx:define>
                        <ToggleButton fx:id="germanToggle" layoutX="14.0" layoutY="50.0" mnemonicParsing="false"
                                      prefHeight="30.0" prefWidth="30.0" AnchorPane.leftAnchor="15.0" selected="true"
                                      toggleGroup="$toggleGroup">
                            <padding>
                                <Insets top="0" right="0" bottom="0" left="0"/>
                            </padding>
                        </ToggleButton>
                        <ToggleButton fx:id="englishToggle" layoutX="55.0" layoutY="50.0" mnemonicParsing="false"
                                      prefHeight="30.0" prefWidth="30.0" AnchorPane.leftAnchor="55.0" selected="false"
                                      toggleGroup="$toggleGroup">
                            <padding>
                                <Insets top="0" right="0" bottom="0" left="0"/>
                            </padding>
                        </ToggleButton>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
        </GridPane>
        <Label id="userNameErrorlabel" layoutX="20.0" layoutY="107.0" text="Lorem ipsum"/>
    </AnchorPane>
    <AnchorPane id="connectingToServerStack" prefHeight="200.0" prefWidth="200.0"
                style="-fx-background-color: rgba(100,100,100,0.5);" visible="false">
        <VBox prefHeight="129.0" prefWidth="358.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label id="connectingToServerLabel" alignment="CENTER" prefHeight="129.0" prefWidth="358.0"
                       text="Lorem ipsum" textFill="WHITE">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </Label>
            </children>
        </VBox>
    </AnchorPane>
    <stylesheets>
        <URL value="@usersetupdialog.css"/>
    </stylesheets>
</StackPane>
