<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" id="root" maxHeight="500.0" maxWidth="400.0" minHeight="500.0"
            minWidth="400.0" prefHeight="500.0" prefWidth="400.0" styleClass="root" xmlns="http://javafx.com/javafx/8"
            fx:controller="de.hhn.seb.labsw.laspoly.debug.GameDebuggerController">
    <children>
        <TextField fx:id="rollField1" layoutX="30.0" layoutY="56.0" prefWidth="50" text="2" AnchorPane.leftAnchor="20.0"
                   AnchorPane.topAnchor="30.0"/>
        <TextField fx:id="rollField2" layoutX="100.0" layoutY="56.0" prefWidth="50" text="5"
                   AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="30.0"/>
        <Label layoutX="10.0" layoutY="25.0" text="Next dice numbers will be:" AnchorPane.leftAnchor="20.0"
               AnchorPane.topAnchor="5.0"/>
        <Button layoutX="105.0" layoutY="108.0" mnemonicParsing="false" onAction="#applyDiceRoll" text="Apply"
                AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="70.0"/>
        <ComboBox fx:id="playerComboBox" layoutX="20.0" layoutY="145.0" prefWidth="150.0" AnchorPane.leftAnchor="20.0"/>
        <ComboBox fx:id="fieldComboBox" layoutX="206.0" layoutY="145.0" prefWidth="150.0"
                  AnchorPane.leftAnchor="206.0"/>
        <Label layoutX="25.0" layoutY="118.0" text="Select Player" AnchorPane.leftAnchor="20.0"/>
        <Label layoutX="206.0" layoutY="118.0" text="Select Field" AnchorPane.leftAnchor="206.0"/>
        <TextField fx:id="moneyAmount" layoutX="20.0" layoutY="207.0" prefWidth="150.0" promptText="Money amount"
                   AnchorPane.leftAnchor="20.0"/>
        <Button layoutX="20.0" layoutY="238.0" mnemonicParsing="false" onAction="#addMoney" text="Add"
                AnchorPane.leftAnchor="20.0"/>
        <Button layoutX="103.0" layoutY="238.0" mnemonicParsing="false" onAction="#removeMoney" text="Remove"
                AnchorPane.leftAnchor="103.0"/>
        <Button layoutX="206.0" layoutY="238.0" mnemonicParsing="false" onAction="#addProperty" text="Add"/>
        <ComboBox fx:id="possibleBuildings" layoutX="206.0" layoutY="274.0" prefWidth="150.0"/>
        <Button layoutX="206.0" layoutY="307.0" mnemonicParsing="false" onAction="#addBuilding" text="Add"/>
        <Button layoutX="289.0" layoutY="307.0" mnemonicParsing="false" onAction="#removeBuilding" text="Remove"/>
        <Label fx:id="errorLabel" alignment="CENTER" layoutX="170.0" layoutY="370.0" style="-fx-text-fill: red;"
               text="Label" textAlignment="CENTER" wrapText="true" AnchorPane.bottomAnchor="20.0"
               AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"/>
        <Button layoutX="289.0" layoutY="237.0" mnemonicParsing="false" onAction="#moveTo" text="Move to"/>
    </children>
</AnchorPane>
