# LasPoly web container environment variables
# Copy to .env and adjust as needed.

# Server listen port (default: 8080)
PORT=8080

# Allowed WebSocket origins.
# Empty = allow all origins (fine for local dev / single-origin deployments).
# In production, set to a comma-separated list of permitted origins, e.g.:
#   ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=
