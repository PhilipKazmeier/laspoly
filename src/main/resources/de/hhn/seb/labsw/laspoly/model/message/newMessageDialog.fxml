                  </ImageView>
                        <Label fx:id="message" maxWidth="278.0" text="Nachricht" wrapText="true" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="42.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="0.0">
