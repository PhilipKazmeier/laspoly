<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import java.net.URL?>
<AnchorPane id="root" maxHeight="500.0" maxWidth="650.0" minHeight="500.0" minWidth="650.0" prefHeight="500.0"
            prefWidth="650.0" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/2.2"
            fx:controller="de.hhn.labsw.laspoly.view.game.lobby.GameLobbyController">
    <ListView fx:id="playerList" layoutX="14.0" layoutY="122.0" prefHeight="200.0" prefWidth="200.0"/>
    <Button fx:id="startGameButton" layoutX="525.0" layoutY="400.0" maxWidth="90.0" minWidth="90.0"
            mnemonicParsing="false" onAction="#startGame" prefWidth="90.0" text="Start game" visible="false"/>
    <Button fx:id="leaveGameButton" layoutX="525.0" layoutY="450.0" maxWidth="90.0" minWidth="90.0"
            mnemonicParsing="false" onAction="#closeGame" prefWidth="90.0" text="Close"/>
    <AnchorPane layoutX="0.0" layoutY="1.0" maxHeight="75.0" maxWidth="650.0" minHeight="75.0" minWidth="650.0"
                prefHeight="75.0" prefWidth="650.0" styleClass="toparea">
            <Label fx:id="gameName" alignment="CENTER" layoutX="175.0" layoutY="27.0" minHeight="-1.0" prefHeight="23.0"
                   prefWidth="300.0" textAlignment="CENTER"/>
        <stylesheets>
            <URL value="@gameLobby.css"/>
        </stylesheets>
    </AnchorPane>
  <padding>
      <Insets bottom="10.0" left="25.0" right="25.0" top="15.0"/>
  </padding>
  <stylesheets>
      <URL value="@gameLobby.css"/>
  </stylesheets>
</AnchorPane>
